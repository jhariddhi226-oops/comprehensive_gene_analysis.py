from Bio import SeqIO
from Bio.Align import PairwiseAligner
import os

# YOUR FASTA FILE PATH
file_path = r"C:\Users\jhari\OneDrive\Desktop\PYTHON\.vscode\BIOPYTHON\Homo sapiens BRCA1 & 2 DNA.FASTA"

def perform_pairwise_alignment(path):
    if not os.path.exists(path):
        print(f"❌ Error: File NOT found at:\n{path}")
        return

    # 1. Load sequences from FASTA file
    records = list(SeqIO.parse(path, "fasta"))

    if len(records) < 2:
        print("❌ Error: Pairwise alignment requires at least 2 sequences in the FASTA file!")
        return

    # Extracting first two sequences (e.g., BRCA1 and BRCA2)
    # Using first 100 bp for clear visual comparison
    seq1 = records[0].seq[:100]
    seq2 = records[1].seq[:100]

    print("=" * 70)
    print("                 PAIRWISE SEQUENCE ALIGNMENT")
    print("=" * 70)
    print(f"Seq 1 ({records[0].id}): {len(seq1)} bp (Subset)")
    print(f"Seq 2 ({records[1].id}): {len(seq2)} bp (Subset)")

    # 2. Configure Aligner
    aligner = PairwiseAligner()
    
    # Global Alignment (Needleman-Wunsch algorithm)
    aligner.mode = 'global'  # Use 'local' for Smith-Waterman alignment
    
    # Optional scoring parameters
    aligner.match_score = 2
    aligner.mismatch_score = -1
    aligner.open_gap_score = -0.5
    aligner.extend_gap_score = -0.1

    # 3. Perform Alignment
    alignments = aligner.align(seq1, seq2)

    print(f"\nAlignment Score : {alignments.score}")
    print(f"Total Optimal Alignments Found: {len(alignments)}")
    print("=" * 70)

    # 4. Display Best Alignment Visual
    best_alignment = alignments[0]
    print("\nBest Alignment Visualization:\n")
    print(best_alignment)

if __name__ == "__main__":
    perform_pairwise_alignment(file_path)